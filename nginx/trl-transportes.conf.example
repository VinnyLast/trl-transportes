# Exemplo de configuracao do Nginx para VPS (proxy reverso)
# Copie para /etc/nginx/sites-available/trl-transportes e crie um link simbolico em sites-enabled.
# Ajuste "seu-dominio.com.br" para o dominio real antes de rodar o Certbot.

server {
    listen 80;
    server_name seu-dominio.com.br www.seu-dominio.com.br;

    # Frontend (container servido pelo nginx interno na porta 8080)
    location / {
        proxy_pass http://127.0.0.1:8080;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # API backend (container na porta 3001)
    location /api/ {
        proxy_pass http://127.0.0.1:3001/api/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}

# Depois de validar o dominio, rode:
#   sudo certbot --nginx -d seu-dominio.com.br -d www.seu-dominio.com.br
# O Certbot ira gerar automaticamente o bloco "listen 443 ssl" e o redirecionamento HTTP -> HTTPS.
