# Porta do servidor da API
PORT=3001

# URL de conexao com o PostgreSQL
DATABASE_URL="postgresql://trl_user:trl_password@localhost:5432/trl_transportes?schema=public"

# Segredo usado para assinar os tokens JWT (gere uma string aleatoria longa)
JWT_SECRET="troque-este-valor-por-um-segredo-forte"

# Tempo de expiracao do token JWT
JWT_EXPIRES_IN="8h"

# Origem permitida para CORS (URL do frontend)
CORS_ORIGIN="http://localhost:5173"

# Valor padrao sugerido para novas rotas (em reais, sem formatacao)
VALOR_ROTA_PADRAO=0
