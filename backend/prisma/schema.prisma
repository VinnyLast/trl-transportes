generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Papel {
  ADMINISTRADOR
  OPERADOR
}

enum StatusMotorista {
  ATIVO
  INATIVO
}

enum StatusVeiculo {
  ATIVO
  MANUTENCAO
  INATIVO
}

// Tipo/categoria do caminhao: usado para casar com o valor certo de cada
// trajeto fixo (ex.: Toco e 3/4 tem precos diferentes para o mesmo destino)
enum TipoVeiculo {
  TOCO
  TRES_QUARTOS
  VAN
  TRUCK
  OUTRO
}

enum StatusRota {
  AGENDADA
  EM_ANDAMENTO
  CONCLUIDA
  CANCELADA
}

enum StatusCliente {
  ATIVO
  INATIVO
}

enum StatusTrajetoFixo {
  ATIVO
  INATIVO
}

model Usuario {
  id        String   @id @default(uuid())
  nome      String
  email     String   @unique
  cpf       String?  @unique
  senhaHash String
  papel     Papel    @default(OPERADOR)
  ativo     Boolean  @default(true)
  criadoEm  DateTime @default(now())
  atualizadoEm DateTime @updatedAt
}

model Motorista {
  id        String          @id @default(uuid())
  nome      String
  cpf       String          @unique
  cnhNumero String?
  cnhCategoria String?
  telefone  String
  senhaHash String?
  status    StatusMotorista @default(ATIVO)
  criadoEm  DateTime        @default(now())
  atualizadoEm DateTime     @updatedAt
  rotas     Rota[]
}

model Veiculo {
  id             String        @id @default(uuid())
  placa          String        @unique
  modelo         String
  capacidadeCarga String?
  tipo           TipoVeiculo   @default(OUTRO)
  status         StatusVeiculo @default(ATIVO)
  criadoEm       DateTime      @default(now())
  atualizadoEm   DateTime      @updatedAt
  rotas          Rota[]
}

model Cliente {
  id        String        @id @default(uuid())
  nome      String
  endereco  String
  contato   String?
  status    StatusCliente @default(ATIVO)
  criadoEm  DateTime      @default(now())
  atualizadoEm DateTime   @updatedAt
  rotas     Rota[]
}

// Trajetos com valor pre-definido (ex.: FEC-BA -> Salvador). Cada trajeto pode
// ter um valor diferente por tipo de veiculo (Toco e 3/4 costumam ter precos
// diferentes para o mesmo destino). Ao criar uma rota (pelo admin ou pelo app
// do motorista) com origem/destino que batem com um trajeto fixo ativo, o
// valor e preenchido automaticamente de acordo com o tipo do veiculo usado.
// Rotas fora da tabela, ou com um tipo de veiculo sem valor definido para
// aquele trajeto, continuam com valor livre/manual.
model TrajetoFixo {
  id               String            @id @default(uuid())
  origem           String
  destino          String
  valorToco        Decimal?          @db.Decimal(10, 2)
  valorTresQuartos Decimal?          @db.Decimal(10, 2)
  valorVan         Decimal?          @db.Decimal(10, 2)
  valorTruck       Decimal?          @db.Decimal(10, 2)
  status           StatusTrajetoFixo @default(ATIVO)
  criadoEm         DateTime          @default(now())
  atualizadoEm     DateTime          @updatedAt

  @@unique([origem, destino])
}

model Rota {
  id             String     @id @default(uuid())
  motorista      Motorista  @relation(fields: [motoristaId], references: [id])
  motoristaId    String
  veiculo        Veiculo    @relation(fields: [veiculoId], references: [id])
  veiculoId      String
  cliente        Cliente?   @relation(fields: [clienteId], references: [id])
  clienteId      String?
  origem         String
  destino        String
  dataSaida      DateTime
  dataChegada    DateTime?
  valor          Decimal    @db.Decimal(10, 2)
  observacoes    String?
  fotoRomaneio   String?
  status         StatusRota @default(AGENDADA)
  criadoEm       DateTime   @default(now())
  atualizadoEm   DateTime   @updatedAt
}
